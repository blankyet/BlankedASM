    mem 0x0000000000000000 ; vmsize: PATCH at file offset 0x88
    mem 0x0000000000000000 ; fileoff = 0
    mem 0x0000000000000000 ; filesize: PATCH at file offset 0x98
    mem 0x0000000700000007 ; maxprot=7, initprot=7
    mem 0x0000000000000000 ; nsects=0, flags=0

.unix_thread
    mem 0x000000B800000005 ; LC_UNIXTHREAD, cmdsize=184
    mem 0x0000002A00000004 ; flavor=4, count=42

    ; x86_64 thread state: 16 general-purpose registers
    mem 0x0000000000000000 ; rax
    mem 0x0000000000000000 ; rbx
    mem 0x0000000000000000 ; rcx
    mem 0x0000000000000000 ; rdx
    mem 0x0000000000000000 ; rdi
    mem 0x0000000000000000 ; rsi
    mem 0x0000000000000000 ; rbp
