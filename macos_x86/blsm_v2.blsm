    mem 0x0000004800000019 ; LC_SEGMENT_64, cmdsize=72
    mem 0x455A454741505F5F ; "__PAGEZE"
    mem 0x0000000000004F52 ; "RO"
    mem 0x0000000000000000 ; vmaddr = 0
    mem 0x0000000100000000 ; vmsize = 4 GiB
    mem 0x0000000000000000 ; fileoff = 0
    mem 0x0000000000000000 ; filesize = 0
    mem 0x0000000000000000 ; maxprot=0, initprot=0
    mem 0x0000000000000000 ; nsects=0, flags=0

