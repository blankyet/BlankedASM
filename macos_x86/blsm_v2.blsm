.reset_token_buf
    push rax
    push rdx
    load .token_buffer
    mov 0x00 to rdx
    setv rdx to rax
    pop rdx
    pop rax
    
    ret
    

.token_buffer
    mem 0x0000000000000000
    array 0x00000300

.str_array ; change to heap later
    mem 0x0000000000000000
    array 0x00000500

.jmp_table
    ; addres of jmp, name ; change to heap later
    mem 0x0000000000000000 ; size
    array 0x00000500

.label_pos
    ; label, address ; change to heap later
    mem 0x0000000000000000 ; size
    array 0x00001500

.opcodes_len
    mem 0x00


.macho_header
    mem 0x01000007FEEDFACF ; magic + x86-64 CPU type
    mem 0x0000000280000003 ; subtype=0x80000003, filetype=MH_EXECUTE
    mem 0x0000014800000003 ; ncmds=3, sizeofcmds=0x148
    mem 0x0000000000000001 ; flags=MH_NOUNDEFS, reserved=0

