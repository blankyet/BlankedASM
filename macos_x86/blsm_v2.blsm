    mem 0x0000000000000000 ; rflags
    mem 0x0000000000000000 ; cs
    mem 0x0000000000000000 ; fs
    mem 0x0000000000000000 ; gs


.opcodes_buf
    array 0x00003000 ; final array have more room beacuse of p_memsz
