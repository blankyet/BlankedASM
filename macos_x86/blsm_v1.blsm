    mov 0x00 to rax
    set_var rax to 0x30 ; overflow len

    mark 0x00000300
        read_var 0x30 to rax
        mov rstack to rsi
        add $in_buffer to rsi
        add rdi to rsi
        sub 0x01 to rsi
        sub rax to rsi
        cmp rdi to rax
        jne 0x1B
            jmp_mark 0x00000310 ;
        

        readv rsi to rax
        mov16 0x000000000000000A to rcx
        mov16 0x00000000000000FF to rbx
        and rbx to rax
        cmp rcx to rbx
        jne 0x1B
            jmp_mark 0x00000310 ; fin counting

        mov16 0x0000000000000020 to rcx
        mov16 0x00000000000000FF to rbx
        and rbx to rax
        cmp rcx to rbx
        jne 0x1B
            jmp_mark 0x00000310 ; fin counting

        test rax
        jnz 0x1B
            jmp_mark 0x00000310 ; fin counting

        read_var 0x30 to rax
        add 0x01 to rax
        set_var rax to 0x30

        jmp_mark 0x00000300
    mark 0x00000310

    
jmp_mark 0x30

mark 0x20
    read_var 0x20 to rax 
    mov rax to rdx


    ; replace labels with offsets
    ; ----- START REPLACE LABELS ------
    mov 0x00 to rdi ; counter; skip first 3 dwords


    mark 0x00000490
    add 0x18 to rdi
    mov rstack to rsi
    add $jmp_map to rsi
    readv rsi to rax ; current label count
    add 0x18 to rax
    cmp rdi to rax
    jne 0x1B
        jmp_mark 0x000004B0

    mov rstack to rsi
    add $jmp_map to rsi
    add rdi to rsi ; add counter

    readv rsi to rax ; first part of label
    set_var rax to 0x70


    mov rstack to rsi
    add $jmp_map to rsi
    add rdi to rsi ; add counter
    add 0x08 to rsi
    readv rsi to rax ; second part of label
    set_var rax to 0x80


    mov rstack to rsi
    add $jmp_map to rsi
    add rdi to rsi ; add counter
    add 0x08 to rsi
    add 0x08 to rsi
    readv rsi to rax ; byte position of jm opcode
    set_var rax to 0x10

    mov rdi to rax
    set_var rax to 0x60 ; save counter
    mov 0x00 to rdi ; new counter for labels search
    ; now find label position
    mark 0x000004A0
        add 0x18 to rdi
        ; if counter over jump out
        mov rstack to rsi
        add $inrlbls to rsi
        readv rsi to rax
        add 0x18 to rax
        cmp rdi to rax
        jne 0x1B
            jmp_mark 0x000004F0 ; or throw error

        add rdi to rsi ; add counter
        readv rsi to rax ; first part of label
        mov rax to rcx
        read_var 0x70 to rax
        cmp rcx to rax
        je 0x1B
            jmp_mark 0x000004A0

        mov rstack to rsi
        add $inrlbls to rsi
        add rdi to rsi 
        
        add 0x08 to rsi

        readv rsi to rax ; second part of label
        mov rax to rcx
        read_var 0x80 to rax
        cmp rcx to rax
        je 0x1B
              jmp_mark 0x000004A0

        ; HORAY found label
    
        mov rstack to rsi
        add $inrlbls to rsi
        add rdi to rsi 


        add 0x10 to rsi
        readv rsi to rax ; rax holds position of label
        mov rax to rcx
        read_var 0x10 to rax ; position of jmp label

        sub rax to rcx
        sub 0x06 to rcx ; skip jmp itself
        ; rcx should hold offset
        mov rstack to rsi          ; rsi = адрес буфера out_buffer
        add $out_buffer to rsi
        add rax to rsi
        
        add 0x06 to rsi ; skip jmp opcode
        readv rsi to rax
        mov rax to rdx

        sub 0x04 to rsi
        readv rsi to rax
        ; mov16 0xFFFF00000000FFFF rax will alway be "je opcode" 3byte zero (cause of JMP) "next opcodes"
        ; 
        mov rcx to rax
        setv rax to rsi

        mov rdx to rax
        add 0x04 to rsi
        setv rax to rsi
        ; updated for one jmp instruction

    read_var 0x60 to rax ; read counter
    mov rax to rdi
    

    jmp_mark 0x00000490

    mark 0x000004B0
    ; ----- END REPLACE LABELS ------
    read_var 0x20 to rax 
    mov rax to rdx
    mov 0x02000004 to rax         ; sys_write (4)
    mov 0x00000001 to rdi   ; rdi = stdout (1)
    mov rstack to rsi          ; rsi = адрес буфера out_buffer
    add $out_buffer to rsi
    syscall                 ; Выводим содержимое файла на экран!


    mov 0x02000001 to rax
    mov 0x00000012 to rdi
    syscall

    mark 0x000004F0

    mov 0x0A727265 to rax
    push rax

    ; Write to stderr
    mov 0x02000004 to rax         ; sys_write (4)
    mov 0x02 to rdi        ; stderr (fd 2)
    mov rstack to rsi         ; rsi points to top of stack ("err\n")
    mov 0x04 to rdx        ; length = 4 bytes
    syscall
    mov 0x02000001 to rax         ; sys_exit (1)
    mov 0x01 to rdi
    syscall

add 0x01 to r15
jmp_mark 0x00
