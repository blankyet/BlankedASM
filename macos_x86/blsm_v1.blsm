        add 0x11 to rax ; skip marking but 0D
        add 0x05 to rax ; skip skp
        mov rax to rsi
        set_var rax to 0x00
        
        mark 0x000000E0 ; mark losses rsi
            read_var 0x00 to rax
            mov rax to rsi
            add 0x0D to rsi ; get to token
            
            readv rsi to rax ; next value  loaded
            mov16 0xFFFFFFFFFFFFFFFF to rbx
            cmp rax to rbx
            jne 0x1B
                jmp_mark 0x00000100
            
            mov rax to rcx ;is a token now

            add 0x0D to rsi ; load mask
            readv rsi to rax 
            add 0x0D to rsi ; go to value for future
            
            mov rax to rbx ; mask in rbx

            mov rsi to rax
            set_var rax to 0x00

            mov rstack to rsi
            add $in_buffer to rsi
            add rdi to rsi
            readv rsi to rax ; reread buffer
            and rbx to rax ; mask out input

            read_var 0x00 to rax
            mov rax to rsi
            cmp rcx to rbx ; if token
            je 0x1B
                jmp_mark 0x000000E0
            
            readv rsi to rax ; rax `is a value we want to store in tokens
            mov rax to rbx

            mov rsi to rax
            set_var rax to 0x00 ; save rsi to 0x00
            
            read_var 0x08 to rax ; current token count

            mov rstack to rsi
            add $tokens to rsi
            add rax to rsi
            setv rbx to rsi ; token is saved

            mov rbx to rcx
            mov16 0xFF00000000000000 to rbx ; get its type from first byte
            and rcx to rbx


            add 0x08 to rsi
            setv rbx to rsi ; type is saved
            add 0x10 to rax ; one toke was added
            set_var rax to 0x08
        
        
        mark 0x00000100
        
        ; ------ PARSE TOKENS END-------

        ; ------ PARSE LABEL START -------
        mov rstack to rsi
