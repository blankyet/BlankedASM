                cmp rcx to rax
                jne 0x27
                    mov 0x40 to rdi
                    jmp_mark 0x00000120 ; jump out

            
                read_var 0x60 to rax
                mov rstack to rsi
                add $in_buffer to rsi
                add rax to rsi ; inner loop
                readv rsi to rax 

                read_var 0x60 to rax
                sub rdi to rax
                mov 0x07 to rcx

                cmp rcx to rax
                jle 0x1B
                    jmp_mark 0x00000380
                    read_var 0x60 to rax
                    sub rdi to rax
                    mov 0x01 to rcx
                    shiftl rax by 0x03
                    shiftl rcx by rax
                    sub 0x01 to rcx

                    ; less than 8 bytes
                    mov rstack to rsi
                    add $in_buffer to rsi
                    add rdi to rsi 
                    readv rsi to rax 

                    and rax to rcx
                    mov rcx to rax
                    set_var rax to 0x40
                    jmp_mark 0x00000400
                mark 0x00000380
                ; more than 8 bytes
